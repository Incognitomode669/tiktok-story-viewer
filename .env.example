# Server only. Generate a key at https://app.konbiniapi.com/
# Save the real value in .env.local. Never use a NEXT_PUBLIC_ prefix.
# KonbiniAPI is the sole active provider. No alternate provider keys are needed.
KONBINI_API_KEY=

# Required for personal keys. Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set the same secret for all instances. Never use a NEXT_PUBLIC_ prefix.
API_KEY_COOKIE_SECRET=
